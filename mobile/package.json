{
  "name": "jay-ai-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-crypto": "~57.0.3",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-image-manipulator": "~57.0.17",
    "expo-image-picker": "~57.0.17",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-markdown-display": "^7.0.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "~19.2.2",
    "sharp": "^0.35.4",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "check": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "export:native": "expo export --platform android --platform ios",
    "build:android": "npx eas-cli@latest build --platform android --profile preview",
    "build:ios": "npx eas-cli@latest build --platform ios --profile production",
    "test:ui": "playwright test",
    "icons": "node scripts/build-icons.cjs",
    "build:android:local": "node scripts/build-android.cjs"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "react-native-markdown-display": {
      "markdown-it": "^15.0.2"
    }
  }
}
